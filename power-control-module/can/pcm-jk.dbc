VAL_TABLE_ ConfigOp 5 "FACTORY_RESET" 4 "REVERT" 3 "COMMIT" 2 "WRITE" 1 "READ" 0 "NOP" ;
VAL_TABLE_ ConfigStatus 5 "LOCKED" 4 "BUSY" 3 "READ_ONLY" 2 "OUT_OF_RANGE" 1 "UNKNOWN_PARAM" 0 "OK" ;
VAL_TABLE_ ResetReason 5 "FW_UPDATE" 4 "PIN" 3 "SOFTWARE" 2 "WATCHDOG" 1 "BROWN_OUT" 0 "POWER_ON" ;


