CM_ "Power control module, module address 0, default base ID 0x6A0. Module n uses base + 0x10*n; regenerate this file for other addresses or a different base.";
CM_ BO_ 1696 "Host to module. Send every 100 ms while controlling outputs; 500 ms without a frame whose alive counter changed is a host timeout.";
CM_ SG_ 1696 OUT1_Req "RELEASE hands the output back to the rule engine.";
CM_ SG_ 1696 OUT1_Duty "PWM duty when Req is ON. 200 = 100 %. 255 = use the configured default.";
CM_ SG_ 1696 OUT1_FaultReset "Rising edge clears a latched fault on OUT1.";
CM_ SG_ 1696 Cmd_AliveCounter "Increment by 1 every frame, wrapping at 15.";
CM_ SG_ 1696 VIN1 "Virtual input for the rule engine, e.g. a CAN keypad button mapped by the host.";
CM_ BO_ 1697 "Module to host. 100 ms, and on any state change (at most every 10 ms).";
CM_ SG_ 1697 ConfigDirty "RAM configuration differs from flash; send ConfigReq COMMIT to persist.";
CM_ SG_ 1697 ModuleCurrent "Sum of all output currents.";
CM_ BO_ 1698 "Module to host, 100 ms.";
CM_ BO_ 1699 "Module to host, 1 s and on change. Temp 255 (raw) = not measured for this cell.";
CM_ SG_ 1699 OUT1_Fault "FaultCode value table.";
CM_ BO_ 1700 "Module to host, 100 ms. Voltage at each input pin.";
CM_ BO_ 1701 "Module to host, 1 s.";
CM_ BO_ 1702 "Host to module configuration access. One request in flight; match responses by Seq.";
CM_ BO_ 1703 "Module to host, reply to ConfigReq.";

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 10000;
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_ "GenMsgCycleTime" BO_ 1696 100;
BA_ "GenMsgCycleTime" BO_ 1697 100;
BA_ "GenMsgCycleTime" BO_ 1698 100;
BA_ "GenMsgCycleTime" BO_ 1699 1000;
BA_ "GenMsgCycleTime" BO_ 1700 100;
BA_ "GenMsgCycleTime" BO_ 1701 1000;

