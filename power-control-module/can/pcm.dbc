BS_:

BU_: HOST PCM0

VAL_TABLE_ OutRequest 3 "RESERVED" 2 "ON" 1 "OFF" 0 "RELEASE" ;
VAL_TABLE_ OutState 3 "FAULT" 2 "PWM" 1 "ON" 0 "OFF" ;
